# Get these from https://dashboard.plaid.com
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_here

# sandbox | development | production
# Start with sandbox for testing, switch to development once ready
PLAID_ENV=sandbox

# ── Cloud deployment only (server-remote) ─────────────────────────
# JSON array of linked bank tokens — generated by `npm run setup` (printed on Ctrl+C)
# PLAID_TOKENS=[{"item_id":"...","access_token":"...","institution_name":"..."}]

# Secret key protecting your remote MCP endpoint — set to any random string
# Generate one with: openssl rand -hex 32
# MCP_API_KEY=your_secret_key_here

# Port the HTTP server listens on (Railway sets this automatically)
# PORT=3000
